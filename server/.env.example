# ================================================================
# Shelfwise Library Management System - Server Environment Config
# ================================================================
# Copy this file to .env before starting the server:
# cp .env.example .env (or run: npm run setup)

# Server port (default: 4000)
PORT=4000

# Environment mode: development | production | test
NODE_ENV=development

# Frontend client URL for CORS permissions
CLIENT_URL=http://localhost:5173

# MongoDB Connection String:
# - For local MongoDB: mongodb://127.0.0.1:27017/shelfwise
# - For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/shelfwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shelfwise

# JSON Web Token Secret (used to sign authentication tokens)
JWT_SECRET=shelfwise_super_secret_jwt_access_key_2026_xyz

# JWT Token expiration period
JWT_EXPIRES_IN=7d

# Demo mode: automatically seeds sample books, members, loans, fines and displays quick login buttons
DEMO_MODE=true

# Timezone
TZ=Asia/Colombo
